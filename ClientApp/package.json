{
  "name": "haddy-sim-hub-client",
  "version": "0.0.0",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev:backend": "node -e \"const m=process.env.TEST_MODE; const a=['run','--project','HaddySimHub','--','--no-update']; if(m){a.push('--test',m);} require('child_process').spawn('dotnet',a,{cwd:'..',stdio:'inherit'}).on('exit',c=>process.exit(c??0));\"",
    "dev:all": "concurrently --kill-others --names backend,frontend --prefix-colors blue,green \"npm:dev:backend\" \"npm:dev\"",
    "dev:all:race": "cross-env TEST_MODE=race npm run dev:all",
    "dev:all:rally": "cross-env TEST_MODE=rally npm run dev:all",
    "dev:all:truck": "cross-env TEST_MODE=truck npm run dev:all",
    "dev:all:flight": "cross-env TEST_MODE=flight npm run dev:all",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest",
    "test_ci": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "npm run lint:ts && npm run lint:styles",
    "lint:ts": "eslint \"src/**/*.ts\"",
    "lint:styles": "stylelint \"**/*.scss\"",
    "build:prod": "vite build",
    "ci": "bash scripts/safe-chain-wrapper.sh npm ci",
    "safe-chain:install": "bash scripts/install-safe-chain.sh",
    "safe-chain:install:ci": "bash scripts/install-safe-chain.sh --ci",
    "safe-chain:verify": "npm safe-chain-verify 2>/dev/null || pnpm safe-chain-verify 2>/dev/null || echo \"Safe Chain not installed\""
  },
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.6.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "@babel/core": "7.29.7",
    "piscina": "5.2.0",
    "rollup": "4.63.3"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "chart.js": "^4.5.1",
    "jsdom": "^30.0.1",
    "lit": "^3.3.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "baseline-browser-mapping": "^2.11.24",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.5",
    "vitest": "^5.0.1"
  }
}

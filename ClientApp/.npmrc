engine-strict=true    # Refuse to install packages that aren't compatible with the node version.
legacy-peer-deps=true # Not recommended, but we need this because of some 3rd party packages that aren't upgraded to EsLint 9
# Supply chain: Aikido Safe Chain wraps npm to check packages against malware DB.
# Install locally via: npm run safe-chain:install  (once per machine)
# In CI, Safe Chain is installed automatically by ci.yml / cd.yml
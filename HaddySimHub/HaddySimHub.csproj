<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Logging\**" />
    <EmbeddedResource Remove="Logging\**" />
    <None Remove="Logging\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HaddySimHub.Shared\HaddySimHub.Shared.csproj" />
    <ProjectReference Include="..\SCSSdkClient\SCSSdkClient.csproj" />
    <ProjectReference Include="..\iRacingSDK.Net\iRacingSDK.Net.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <!--
    Frontend integration: on `dotnet publish`, build the Angular client and
    place its output in wwwroot so the published app is self-contained. This is
    the single source of truth for the "build client + copy to wwwroot" step
    (used by the CD workflow and by anyone running `dotnet publish` locally).

    It deliberately hooks into the publish pipeline only, so a plain
    `dotnet build`/`dotnet test` (e.g. the CI server-tests, which have no Node)
    is unaffected and stays fast. The fast dev loop uses `ng serve` instead.

    Set `-p:BuildClientAppOnPublish=false` to skip it (e.g. publishing on a
    machine without Node).
  -->
  <PropertyGroup>
    <BuildClientAppOnPublish Condition="'$(BuildClientAppOnPublish)' == ''">true</BuildClientAppOnPublish>
    <ClientAppDir>$(MSBuildThisFileDirectory)../ClientApp</ClientAppDir>
    <ClientAppDist>$(ClientAppDir)/dist/haddy-sim-hub-client/browser</ClientAppDist>
  </PropertyGroup>

  <Target Name="PublishClientApp"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(BuildClientAppOnPublish)' == 'true'">
    <Message Importance="high" Text="Building Angular client app for publish..." />
    <Exec Command="npm ci" WorkingDirectory="$(ClientAppDir)" Condition="!Exists('$(ClientAppDir)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientAppDir)" />
    <ItemGroup>
      <_ClientAppDist Include="$(ClientAppDist)/**" />
      <ResolvedFileToPublish Include="@(_ClientAppDist)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    Microsoft Flight Simulator telemetry needs the native x64 SimConnect.dll. That
    library ships with the MSFS SDK, not with the simulator and not with this
    repository, so it cannot be committed or fetched by the release workflow (which
    builds on a Linux runner with no SDK installed).

    At runtime SimConnectLibraryResolver finds it next to the executable or in an SDK
    install, so a developer machine with the SDK needs no packaging at all. Set
    `-p:IncludeSimConnectOnPublish=true` to bundle it into the published output
    instead, for distributing to machines without the SDK. It is opt-in because
    redistributing the library is a licensing decision for whoever cuts the release,
    not a side effect of publishing.
  -->
  <PropertyGroup>
    <IncludeSimConnectOnPublish Condition="'$(IncludeSimConnectOnPublish)' == ''">false</IncludeSimConnectOnPublish>
    <SimConnectDllPath Condition="'$(SimConnectDllPath)' == '' and '$(MSFS_SDK)' != ''">$([MSBuild]::EnsureTrailingSlash('$(MSFS_SDK)'))SimConnect SDK\lib\SimConnect.dll</SimConnectDllPath>
    <SimConnectDllPath Condition="'$(SimConnectDllPath)' == ''">C:\MSFS SDK\SimConnect SDK\lib\SimConnect.dll</SimConnectDllPath>
  </PropertyGroup>

  <Target Name="PublishSimConnect"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(IncludeSimConnectOnPublish)' == 'true'">
    <!-- Fail loudly: a package that silently lacks the library would look fine and
         then leave the flight dashboard permanently inactive. -->
    <Error Condition="!Exists('$(SimConnectDllPath)')"
           Text="IncludeSimConnectOnPublish is set but SimConnect.dll was not found at '$(SimConnectDllPath)'. Install the MSFS SDK, or pass -p:SimConnectDllPath=&lt;path&gt;." />
    <Message Importance="high" Text="Bundling SimConnect.dll from $(SimConnectDllPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(SimConnectDllPath)">
        <RelativePath>SimConnect.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
